# Copie para .env.staging (gitignored) ou exporte no shell.
# Neon claim / Postgres gerenciado — use a URL UNPOOLED para Flyway/JDBC.

# Spring espera JDBC (não o formato postgresql:// do Neon):
DATABASE_URL=jdbc:postgresql://ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_USERNAME=neondb_owner
DATABASE_PASSWORD=changeme

APP_PROFILE=prod
# Staging local: localhost. Produção: ver deploy/urls.example.env (www + api + HTTPS)
CORS_ORIGINS=http://localhost:5173
PASSWORD_RECOVER_URI=http://localhost:5173/recover-password/
CLIENT_ID=mshop-staging-client
CLIENT_SECRET=change-me-staging-secret
JWT_DURATION=900
JWT_REFRESH_DURATION=604800
SECURITY_TOKEN_URI=http://127.0.0.1:8080/oauth2/token

# SMTP — Ethereal/Mailpit/produção
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_SMTP_AUTH=true
EMAIL_SMTP_STARTTLS=true
