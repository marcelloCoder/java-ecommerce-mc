# Local
VITE_API_URL=http://localhost:8080

# Produção / preview (build-time): URL pública HTTPS da API
# Vercel: Project → Settings → Environment Variables → VITE_API_URL
# Cloudflare Pages: Settings → Environment variables → VITE_API_URL
# VITE_API_URL=https://api.seudominio.com

# Login uses POST /auth/login (BFF). Client id/secret stay only on the backend.
# Backend production DB (PostgreSQL): APP_PROFILE=prod
# Backend test DB (H2): APP_PROFILE=test (default)
