# URLs finais do mShop (produção).
# Copie para deploy/urls.env e preencha com o domínio real.
# deploy/urls.env é gitignored — não commite o domínio se for privado; URLs públicas podem ir no README.

# Apex (sem www) — opcional, redireciona para www
MSHOP_DOMAIN=seudominio.com

# Front (SPA) — Vercel / Cloudflare Pages + domínio custom + HTTPS
FRONT_URL=https://www.seudominio.com

# API — Render / Railway / Fly / Cloud Run + domínio custom + HTTPS
API_URL=https://api.seudominio.com

# --- Envs derivados (colar nos hosts) ---

# Front (build-time)
VITE_API_URL=https://api.seudominio.com

# API (runtime, APP_PROFILE=prod)
CORS_ORIGINS=https://www.seudominio.com
PASSWORD_RECOVER_URI=https://www.seudominio.com/recover-password/

# Se o front também responder no apex:
# CORS_ORIGINS=https://www.seudominio.com,https://seudominio.com
