# Copie para deploy/prod.env (gitignored). Não commite senhas.
# Neon: projeto mshop-prod. Use o host DIRETO (sem -pooler) no JDBC do Flyway.

APP_PROFILE=prod
DATABASE_URL=jdbc:postgresql://ep-xxxx.c-7.us-east-2.aws.neon.tech/mshop?sslmode=require
DATABASE_USERNAME=mshop
DATABASE_PASSWORD=changeme
NEON_PROJECT_ID=winter-voice-63495786

CLIENT_ID=mshop-prod-client
CLIENT_SECRET=changeme
JWT_DURATION=900
JWT_REFRESH_DURATION=604800
SECURITY_TOKEN_URI=http://127.0.0.1:8080/oauth2/token

# Preencha depois do deploy do front (Vercel) e da API (Render).
CORS_ORIGINS=https://www.seudominio.com
PASSWORD_RECOVER_URI=https://www.seudominio.com/recover-password/

# SMTP real (Resend, Brevo ou SES). Sem isto o recover não envia e-mail.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_SMTP_AUTH=true
EMAIL_SMTP_STARTTLS=true

PROD_ADMIN_EMAIL=admin@mshop.prod
PROD_ADMIN_PASSWORD=changeme
